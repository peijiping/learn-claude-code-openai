# =============================================================================
#  ⚠️ 遗留兜底文件（legacy fallback）
#  新配置请写入 ~/.aigent/config.json（非敏感配置，扁平键同本文件键名）；
#  密钥（*_API_KEY / *_TOKEN / *_SECRET）写入 ~/.aigent/credentials.json（0600）。
#  本文件仅作旧环境兜底，加载优先级低于 ~/.aigent 配置与真实环境变量。
#  新增/修改参数时，请同步更新本文件注释示例。
# =============================================================================

# API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID —— 已废弃：模型选择统一在 ~/.aigent/llmconfig.json（连接中心）配置

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
#  Anthropic-compatible providers
#
#  Provider         MODEL_ID              SWE-bench  TB2     Base URL
#  ---------------  --------------------  ---------  ------  -------------------
#  Anthropic        claude-sonnet-4-6     79.6%      59.1%   (default)
#  MiniMax          MiniMax-M2.5          80.2%        -     see below
#  GLM (Zhipu)      glm-5                77.8%        -     see below
#  Kimi (Moonshot)  kimi-k2.5            76.8%        -     see below
#  DeepSeek         deepseek-chat        73.0%        -     see below
#                   (V3.2)
#
#  SWE-bench = SWE-bench Verified (Feb 2026)
#  TB2       = Terminal-Bench 2.0 (Feb 2026)
# =============================================================================

# =============================================================================
#  LLM 模型/端点配置 —— 已废弃，统一由 ~/.aigent/llmconfig.json 管理
# =============================================================================
# 模型选择（主/备）、Base URL、思考档位、上下文窗口（标准/扩展）均在
# llmconfig.json 的模型条目里配置（连接中心 v2，见 docs/frontend/06），
# 由 llm_config.apply_to_env() 启动时映射进 env。
# 已废弃键（代码不再读取，config.json / .env 中请删除）：
#   MODEL_ID / USE_OPENAI_API / OPENAI_BASE_URL / OPENAI_MODEL_ID /
#   FALLBACK_MODEL_ID / MAX_CONTEXT_TOKENS / DEFAULT_MAX_CONTEXT_TOKENS
# 密钥仍走 ~/.aigent/credentials.json（或真实环境变量）兜底：
# OPENAI_API_KEY=sk-xxx
# 常用端点参考（在 llmconfig.json 连接里配置）：
#   MiniMax (国内): https://api.minimaxi.com/v1    MiniMax (国际): https://api.minimax.io/v1
#   DeepSeek: https://api.deepseek.com/v1           Kimi: https://api.moonshot.ai/v1
#   GLM: https://open.bigmodel.cn/api/paas/v4

# GLM (Zhipu)      https://z.ai
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek         https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# ---- China mainland ----

# MiniMax          https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.5

# DeepSeek (no regional split, same endpoint globally)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# =============================================================================
#  Context Compact 压缩参数（context_compact.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# L1 snip 压缩：消息条数阈值 / 保留头尾
# SNIP_MAX_MESSAGES=50
# SNIP_KEEP_HEAD=3
# SNIP_KEEP_TAIL=47

# L2 micro_compact：保留最近 N 条 tool_result 不动
# KEEP_RECENT_TOOL_RESULTS=3

# L3 tool_result_budget：单条 tool_result 落盘阈值 / 单条 user 消息内 tool_result 字节上限 / 落盘后预览字符数
# PERSIST_THRESHOLD=30000
# MAX_TOOL_RESULT_BYTES=200000
# PREVIEW_LENGTH=2000

# L4 摘要触发比率（L1/L2/L3 无前置阈值，每轮必跑由各层内部判断；仅 L4 由该比例门控）
# SUMMARY_TRIGGER_RATIO=0.80

# L4 摘要时，保留最后 N 条消息原文不被摘要
# PRESERVE_RECENT_SUMMARY_MESSAGES=10

# =============================================================================
#  Error Recovery 错误恢复参数（error_recovery.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 截断时第一次升级到的 max_tokens 上限
# ESCALATED_MAX_TOKENS=64000

# 首轮请求的 max_tokens（升级前的额度）
# DEFAULT_MAX_TOKENS=8000

# max_tokens 截断后的最大续写次数
# MAX_RECOVERY_RETRIES=3

# 内层 with_retry 对 429/503 的最大重试次数
# MAX_RETRIES=10

# 指数退避的初始延迟（毫秒）；实际等待 = base * 2^attempt + 随机抖动
# BASE_DELAY_MS=500

# 退避上限（毫秒），防止指数爆炸
# BACKOFF_CAP_MS=32000

# 连续 503 错误次数上限；达到后切换到 FALLBACK_MODEL
# MAX_CONSECUTIVE_503=3

# 续写提示：模型输出被 max_tokens 截断后，追加到 messages 的 user 消息
# CONTINUATION_PROMPT=输出已达 token 上限，直接续写 —— 不要道歉，不要复述，从中途中断处接着往下写。

# =============================================================================
#  「承诺未兑现」守卫参数（agent_full_v2.py）
#  模型偶尔只回一句"我派/我这就去…"却不发起任何工具调用就 stop，
#  停止边界会把它当"想收尾"，本轮直接结束（表现为"直接中断、不往下执行"）。
#  守卫据此回注一条提醒让它把话说圆。取消注释即可覆盖默认值。
# =============================================================================

# 每轮最多拦截次数（0 = 关闭守卫）
# PROMISE_GUARD_MAX=1

# 触发长度上限（字）：最终答复通常远超此值，占位承诺天然很短 —— 这是防误拦的主阀门
# PROMISE_GUARD_MAX_CONTENT_CHARS=240

# =============================================================================
#  SubAgent 子智能体参数（subagent.py）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 子智能体单轮 max_tokens 预算
# 思考模式开启 + reasoning_effort=high 时 4000 经常被思考耗光，导致 content 为空 → (no summary)
# 8000 与 Error Recovery 的 DEFAULT_MAX_TOKENS 对齐
# SUBAGENT_MAX_TOKENS=8000

# =============================================================================
#  团队成员（teammate_manager.py，s17 自主智能体）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 空闲等待的兜底周期（秒）；配合 Event 即时唤醒，仅作无事件时的兜底
# IDLE_POLL_INTERVAL=5

# 空闲超时时间（秒），超过则队友关闭；调短可加快空闲队友回收
# IDLE_TIMEOUT=60

# 每轮 WORK 阶段最多 tool_use 轮数
# TEAM_MAX_TOOL_ROUNDS=5

# 队友每轮 LLM 生成的 max_tokens（聚焦小任务，宜小以提速）
# TEAM_MAX_TOKENS=4096

# =============================================================================
# Worktree 隔离（worktree.py，s18）
# 取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# git 命令（worktree add/remove）超时秒数
# WORKTREE_GIT_TIMEOUT=30

# 创建 worktree 时的运行时软链供给（worktree.py，s18+）：
# - 缺省（未设置本变量）→ 自动检测仓库技术栈（python/node/go/rust/java/…，
#   见 worktree.py 的 STACK_PROVISIONS），软链该栈对应运行时（.venv、node_modules、
#   target 等），并恒软链 .env。
# - 显式设置本变量 → 当作完整清单直接使用，**不再自动检测**。逗号分隔顶层相对名。
#   .venv/.env 等被 .gitignore 忽略但运行时必需文件不会出现在 worktree 检出里，
#   软链让 worktree 内 agent 能运行/测试。可按需追加如 .pixi、.npmrc。
# WORKTREE_SYMLINKS=.venv,.env

# =============================================================================
#  MCP（mcp.py，s19 真实 MCP）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# MCP 工具调用超时（秒），call_tool 经 run_coroutine_threadsafe 等待的 timeout
# MCP_CALL_TIMEOUT=60

# 允许 MCP 破坏性工具直接执行（默认 false：交互模式弹窗确认，silent 模式默认拒绝）
# MCP_ALLOW_DESTRUCTIVE=false

# =============================================================================
#  工作流运行时（workflow.py，s16）
# =============================================================================

# 单次运行内 agent() 调用次数的硬上限（防止工作流无限派生子智能体）
# WORKFLOW_AGENT_CAP=1000

# 并发上限：信号量控制同时真实运行的子智能体数量
# WORKFLOW_CONCURRENCY=8

# 工作流子智能体单次 LLM 调用的 max_tokens
# WORKFLOW_MAX_TOKENS=2000

# =============================================================================
#  目标循环（goal.py，s17 Goal Loop）
#  取消注释并修改即可覆盖代码中同名默认值；建议保留示例值以便快速对照
# =============================================================================

# 评估器所用模型（独立的完成度评判模型，可为更便宜的模型）；留空则复用主模型
# GOAL_EVALUATOR_MODEL_ID=

# Stop 钩子连续判"未完成"（block）的次数上限，超过则强制结束，避免死循环
# GOAL_STOP_HOOK_BLOCK_CAP=8

# =============================================================================
#  系统提示词分层（system_prompt.py）
#  分层按「变化频率」排列，以最大化前缀缓存命中：
#    L0 冻结段（身份/输出格式/工具策略/技能列表）→ L1 冷段（workspace 指令文件，排在最末尾）
#  记忆索引不在 system prompt 里 —— 由 agent_full_v2._sync_memory_index() 在指纹
#  变化时以「尾部追加」方式注入，避免改动 [0] 导致整段前缀失效。
# =============================================================================

# 技能列表在静态段中的单条描述最大字符数；超出截断为 …（完整描述仍可由 list_skills 工具获取）
# SKILL_DESC_MAX_CHARS=120

# =============================================================================
#  日志（agents/logger.py + frontend/src/main/logger.ts）
#  落盘目录 ~/.aigent/logs，文件按日期命名：agent_YYYY-MM-DD.log / frontend_YYYY-MM-DD.log
# =============================================================================

# 日志级别：DEBUG / INFO（默认）/ WARNING / ERROR
# LOG_LEVEL=INFO

# =============================================================================
#  会话附件（agents/attachments.py，2026-09-20）
#  「添加文件或图片」：文件复制进 ~/.aigent/projects/<id>/.attachments/，
#  草稿区 _draft/ 放尚未发送的附件。以下均为可调项，改后重启后端生效。
#  设计见 docs/frontend/12-附件与文件输入.md
# =============================================================================

# 未发送草稿的存活时间（秒），超期由 GC 清理；默认 72 小时
# ATTACHMENT_DRAFT_TTL_SECONDS=259200

# 孤儿附件目录（会话已不存在）的清理门限（秒）；默认 24 小时
# 门限存在的理由：会话刚创建、jsonl 还没落盘时不误杀
# ATTACHMENT_ORPHAN_MIN_AGE_SECONDS=86400

# 单张图片体积上限（字节，默认 10MB）／单个文档体积上限（字节，默认 50MB）
# ATTACHMENT_IMAGE_MAX_BYTES=10485760
# ATTACHMENT_DOC_MAX_BYTES=52428800

# 单个文档抽取文本的字符上限（默认 30000，与 run_read_pdf 同口径）
# ATTACHMENT_TEXT_MAX_CHARS=30000

# 一条消息内所有附件文本的合计上限（默认 60000）
# ATTACHMENT_TEXT_TOTAL_MAX_CHARS=60000

# 发送用图片的长边上限（像素，默认 1568；0 = 不缩放，始终发原图）
# 超过就会用 Pillow 生成 <att_id>.send.jpg，省 vision token，原图仍保留供查看
# ATTACHMENT_IMAGE_MAX_EDGE=1568

# 单张图片内联进请求体的字节上限（默认 15MB，base64 后约 20MB）
# 超过则降级为占位文本（明确告知模型"这张图太大没发出去"）
# ATTACHMENT_INLINE_MAX_BYTES=15728640

# ── 文档统一转换层（PDF 页图随附，2026-09-20）────────────────────────
# 单文档最多渲染多少页页图（默认 20；0 = 不限）。
# 只约束页图数量，文本层永远是全量的 —— 文本是检索与无视觉模型兜底的主通道。
# ATTACHMENT_DOC_MAX_PAGES=20

# 单文档随附的图片总数上限（默认 20；0 = 不限）
# DeepSeek 的硬限是 600 张/请求，20 是 UX 值：再多也读不过来，只会撑大请求体。
# ATTACHMENT_DOC_MAX_IMAGES=20

# 页文本短于此值时判定"文本层不足以代表本页"→ 渲染页图（默认 200 字符）
# 这是页图渲染的主判据：文本层够密又没有图/表时，页图提供不了额外信息，
# 渲染它纯属浪费请求体。调大 = 更保守地渲染（更贵、覆盖更全）。
# ATTACHMENT_DOC_PAGE_IMAGE_MIN_TEXT=200

# 页图的 detail 档位（默认 high；可选 low / high / original / auto）
# low 会在推理前缩到 512×512。DeepSeek 服务端本就把每张图的 token 封在 1024 以内，
# 选 low 省不到 token、只省请求体。留空则不下发该字段。
# ATTACHMENT_IMAGE_DETAIL=high
